{
  "manifest_version": 2,
  "name": "Colombes App Bridge",
  "version": "1.0.0",
  "description": "Pont entre le site et l'application Colombes",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["nativeMessaging", "<all_urls>"]
}
