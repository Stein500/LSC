<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rouge_colombe_dark" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/rouge_colombe"
                android:centerColor="@color/rouge_colombe"
                android:endColor="@color/rouge_colombe_dark" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</selector>
