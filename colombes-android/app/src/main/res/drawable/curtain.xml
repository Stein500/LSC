<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Panneau sombre -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#101018" />
        </shape>
    </item>
    <!-- Bord doré (fil d'or) sur le bord intérieur -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#33C9A87C"
                android:centerColor="#00C9A87C"
                android:endColor="#33C9A87C" />
        </shape>
    </item>
</layer-list>
