<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème principal : Material 3, sans barre d'action, immersion totale -->
    <style name="Theme.Colombes" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/citron</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/marron</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/sky_blue</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Thème du splash : fond sombre, pas de barre d'action -->
    <style name="Theme.Colombes.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
