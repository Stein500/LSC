<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème principal : rose poudré + rouge colombe, sans barre d'action -->
    <style name="Theme.Colombes" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/rouge_colombe</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/marron</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/rose_poudre</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/rose_poudre</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Thème du splash : fond sombre -->
    <style name="Theme.Colombes.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Thème du hub natif : barre de statut rose poudré (pas noire) -->
    <style name="Theme.Colombes.Home" parent="Theme.Colombes">
        <item name="android:statusBarColor">@color/rose_poudre</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/rose_poudre</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
