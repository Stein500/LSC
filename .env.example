# =============================================================
# Les Services Colombes — template de configuration
# Copier en .env pour dev local. Adapter pour la prod.
# =============================================================

# === IDENTITÉ (Front) ===
VITE_ATELIER_NAME="Les Services Colombes"
VITE_ATELIER_SHORT_NAME="Colombes"
VITE_ATELIER_TAGLINE="Atelier de Couture d'Exception"
VITE_ATELIER_DESCRIPTION="Couture sur mesure, mercerie, layette & formations à Porto-Novo"
VITE_ATELIER_FOUNDED="1990"
# Super accroche affichée sur l'accueil juste après le hero (remplace
# les 4 anciennes cartes stats). Une seule phrase, sans point final
# obligatoire — l'UI ajoute la ponctuation. Garder < 90 caractères.
VITE_ATELIER_HERO_HOOK="Trois décennies de savoir-faire, au service de votre élégance."

# === LOCALISATION ===
# Adresse affichée sur la fiche Google (raccourcie pour les blocs visuels)
VITE_ATELIER_LOCATION="Les Services Colombes, Porto-Novo – Bénin"
# Adresse longue / exacte pour les schema SEO et mentions légales
VITE_ATELIER_LOCATION_FULL="Les Services Colombes, Porto-Novo – Bénin"
# Coordonnées GPS de la fiche (utilisées en fallback de recherche)
VITE_ATELIER_LAT="6.4922053"
VITE_ATELIER_LNG="2.6004269"
# Lien direct vers la fiche Google Maps (raccourci officiel)
VITE_MAPS_URL="https://maps.app.goo.gl/A14pmkvWbbxpwS4J6"
# Embed iframe — requête précise vers la fiche
VITE_MAPS_EMBED="https://www.google.com/maps?q=Les+Services+Colombes&ll=6.4922053,2.6004269&output=embed"

# === TÉLÉPHONES ===
VITE_ATELIER_PHONE="+229 01 67 40 94 08"
VITE_ATELIER_PHONE_RAW="2290167409408"
VITE_ATELIER_PHONE_2="+229 01 95 76 36 01"
VITE_ATELIER_PHONE_2_RAW="2290195763601"
VITE_ATELIER_EMAIL="lesservicescolombes@gmail.com"

# === WHATSAPP ===
VITE_WHATSAPP_GENERAL="+229 01 67 40 94 08"
VITE_WHATSAPP_GENERAL_RAW="2290167409408"
VITE_WHATSAPP_SECRETARIAT="+229 01 67 40 94 08"
VITE_WHATSAPP_SECRETARIAT_RAW="2290167409408"
VITE_WHATSAPP_DIRECTION="+229 01 95 76 36 01"
VITE_WHATSAPP_DIRECTION_RAW="2290195763601"

# === RÉSEAUX (optionnels) ===
VITE_FACEBOOK_URL=""
VITE_INSTAGRAM_URL=""
VITE_TIKTOK_URL=""
VITE_PORTAL_URL=""

# === SEO / URL canonique ===
VITE_SITE_URL="https://couturecolombe.vercel.app"

# === API BACK-END (autonome, dans api/track.js) ===
# RELATIF = le même build tourne sur prod, previews Vercel et dev local.
VITE_API_URL="/api/track"
# Liste prête à copier-coller, variable par variable, dans VERCEL_ENV.md
VITE_TRACK_TOKEN="COLLE_ICI_UNE_VALEUR_IDENTIQUE_A_TRACK_PUBLIC_TOKEN"
VITE_ATELIER_SOURCE_ID="atelier-colombes"

# =============================================================
# SERVER-ONLY (lus par api/track.js & api/lib/*)
# NE PAS préfixer VITE_ — NE PAS commit — Mettre sur Vercel
# =============================================================

# Token admin SERVER-ONLY (NE PAS préfixer VITE_ — sinon fuite dans le bundle JS)
TRACK_TOKEN="COLLE_ICI_UNE_VALEUR_ADMIN_SECRET"

# Token PUBLIC partagé front/back pour le tracking analytics (sans danger côté client)
TRACK_PUBLIC_TOKEN="COLLE_ICI_UNE_VALEUR_IDENTIQUE_A_VITE_TRACK_TOKEN"

# Google Sheets (compte de service)
GOOGLE_SHEET_ID="COLLE_ICI_TON_GOOGLE_SHEET_ID"
GOOGLE_SERVICE_ACCOUNT_EMAIL="tracking-service@VOTRE_PROJET.iam.gserviceaccount.com"
# Clé privée complète avec BEGIN/END — garder les \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLLE_CLE_PRIVEE_ICI\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_RANGE="Events!A:K"

# SMTP Gmail (INCHANGEABLE)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="votre-compte-smtp@gmail.com"
SMTP_PASS="abcd efgh ijkl mnop"
MAIL_TO="destinataire1@exemple.com,destinataire2@exemple.com"
MAIL_FROM="Les Services Colombes <votre-compte-smtp@gmail.com>"
ATELIER_LOGO_URL=""
